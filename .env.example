# =================================================================
# whatsmeow-coolify-bot Configuration
# =================================================================

# HTTP Server Port
PORT=8080

# WhatsApp Linked Phone Number (E.164 without '+' or dashes, e.g. 6281234567890)
# Jika dikosongkan, pairing code bisa dipicu lewat REST API: POST /api/v1/session/pair
WA_PHONE_NUMBER=6281234567890

# Client Display Name shown on WhatsApp Web Linked Devices list
WA_CLIENT_NAME=Chrome (Coolify)

# Discord Webhook URL for Alerts & Real-time Pairing Code delivery
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/abcdefghijk

# API Secret Key for securing REST API endpoints (X-API-Key or Authorization: Bearer <key>)
# Sangat disarankan untuk lingkungan production
API_KEY=your-super-secret-api-key-here

# Anti-ban Preset: strict | moderate | relaxed
# - strict: delay 4-8s, burst 5, max 80 msg/day (cocok untuk nomor baru)
# - moderate: delay 2-5s, burst 15, max 300 msg/day (standar)
# - relaxed: delay 1-3s, burst 30, max 1000 msg/day (nomor matang/tua)
ANTIBAN_PRESET=moderate

# Postgres Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_change_me
POSTGRES_DB=whatsmeow

# Logging level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Domain managed by Coolify / Traefik (e.g. wa.yourdomain.com)
COOLIFY_FQDN=wa.yourdomain.com
